diff --git a/main/System/Interrupt.hs b/main/System/Interrupt.hs
new file mode 100644
index 0000000..1ede24c
--- /dev/null
+++ b/main/System/Interrupt.hs
@@ -0,0 +1,33 @@
+{-# LANGUAGE CPP #-}
+
+-- | Ctrl-C handling, kept out of "Main" so that only this module needs the
+-- C preprocessor (CPP would mangle the string gaps in Main's help texts).
+module System.Interrupt (
+  exitOnInterrupt,
+)
+where
+
+#if defined(mingw32_HOST_OS)
+
+-- | On Windows GHC's runtime turns Ctrl-C into an asynchronous exception,
+-- which "System.IO.Atomic" already handles by rolling the write back.
+exitOnInterrupt :: IO ()
+exitOnInterrupt = pure ()
+
+#else
+
+import System.Exit (ExitCode (..))
+import System.Posix.Process (exitImmediately)
+import System.Posix.Signals (Handler (..), installHandler, keyboardSignal)
+
+-- | Exit immediately with status 2 on SIGINT.
+exitOnInterrupt :: IO ()
+exitOnInterrupt = do
+  _ <-
+    installHandler
+      keyboardSignal
+      (Catch (exitImmediately $ ExitFailure 2))
+      Nothing
+  pure ()
+
+#endif
