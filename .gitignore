.repro/
build/
# A recipe built for a target keeps its build tree beside the native one,
# keyed by the triple (`build@armv7-unknown-linux-gnueabihf/`); without this
# every target build left the catalog checkout reporting untracked trees.
build@*/
result
result-*
packages/source/*/src/
packages/source/grub/build-grub-*/
/tools/package_interface_fingerprints
/tools/package_interface_fingerprints.exe
__pycache__/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/
